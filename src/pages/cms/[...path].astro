---
import config from '../../../cms.config.json';
import { siteConfig } from '../../site.config';
// The new editor, mounted next to the old one so the two can be compared before switching over.
export function getStaticPaths() {
  return siteConfig.cms.enabled ? [{ params: { path: undefined } }] : [];
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>V7 · 写作后台</title>
    <link rel="stylesheet" href="/cms/cms.css" />
    <script
      is:inline
      type="application/json"
      id="v7-config"
      set:html={JSON.stringify(config).replace(/</g, '\\u003c')}
    />
  </head>
  <body>
    <noscript>写作后台需要 JavaScript。</noscript>
    <div id="cms-root"></div>
    <script is:inline type="module">
      import { mount } from '/cms/v7-cms.js';
      const config = JSON.parse(document.getElementById('v7-config').textContent);
      mount({ container: '#cms-root', config });
    </script>
  </body>
</html>
