/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/*
  Cache-Control: public, max-age=0, must-revalidate
# The editor bundle keeps its name across releases, so a long max-age serves the previous build
# after a deploy — and an editor with a stale config is a sign-in that 404s with no visible cause.
# It is one file, so revalidation is cheap.
/admin/*
  Cache-Control: public, max-age=0, must-revalidate
